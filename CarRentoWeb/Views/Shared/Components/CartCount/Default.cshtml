@model int

<a class="nav-link text-white position-relative" asp-area="Customer" asp-controller="Cart" asp-action="Index">
    <i class="bi bi-cart3"></i> Cart
    @if (Model > 0)
    {
        <span class="badge rounded-pill bg-danger position-absolute top-0 start-100 translate-middle">
            @Model
        </span>
    }
</a>
