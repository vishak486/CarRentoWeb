@model Car

<div class="container py-5">
    <div class="row gy-4">
        <div class="col-lg-6">
            @if (Model.CarImages != null && Model.CarImages.Any())
            {
                <div id="carImageCarousel" class="carousel slide shadow-sm" data-bs-ride="carousel">
                    <div class="carousel-inner rounded">
                        @{
                            var first = true;
                        }
                        @foreach (var img in Model.CarImages)
                        {
                            <div class="carousel-item @(first ? "active" : "")">
                                <img src="@img.ImageUrl" class="d-block w-100" style="height: 450px; object-fit: cover;" alt="@Model.CarName" />
                            </div>
                            first = false;
                        }
                    </div>

                    @if (Model.CarImages.Count() > 1)
                    {
                        <button class="carousel-control-prev" type="button" data-bs-target="#carImageCarousel" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon"></span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#carImageCarousel" data-bs-slide="next">
                            <span class="carousel-control-next-icon"></span>
                        </button>
                    }
                </div>
            }
            else
            {
                <div class="bg-light rounded d-flex align-items-center justify-content-center" style="height: 350px;">
                    <span class="text-muted">No images available</span>
                </div>
            }
        </div>

        <div class="col-lg-6">
            <h2 class="fw-bold">@Model.CarName</h2>
            <p class="text-muted">@Model.Brand?.BrandName</p>

            <table class="table table-borderless mt-3">
                <tbody>
                    <tr><th>Model</th><td>@Model.Model</td></tr>
                    <tr><th>Year</th><td>@Model.Year</td></tr>
                    <tr><th>Transmission</th><td>@Model.Transmission</td></tr>
                    <tr><th>Fuel Type</th><td>@Model.FuelType</td></tr>
                    <tr><th>Seating Capacity</th><td>@Model.SeatingCapacity</td></tr>
                    <tr><th>Status</th><td><span class="badge bg-success">@Model.Status</span></td></tr>
                </tbody>
            </table>

            <h4 class="fw-bold text-primary mb-4">₹@Model.PricePerDay.ToString("N2") / day</h4>
            <div class="mb-3">
                <label class="form-label">Rental Start Date</label>
                <input type="date" id="rentalStartDate" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>
            <div class="mb-3">
                <label class="form-label">Rental End Date</label>
                <input type="date" id="rentalEndDate" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
            </div>

            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                if ((bool)ViewBag.IsProfileComplete)
                {
                    <button id="addToCartBtn" class="btn btn-primary btn-lg w-100" data-car-id="@Model.CarId">Add to Cart</button>
                }
                else
                {
                    <button class="btn btn-secondary btn-lg w-100" disabled>Add to Cart</button>
                    <a asp-area="Identity" asp-page="/Account/Manage/Index" class="btn btn-warning w-100 mt-2">Complete Your Profile to Continue</a>
                }
            }
            else
            {
                <button class="btn btn-secondary btn-lg w-100" disabled>Add to Cart</button>
                <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Url.Action("Details", "Cars", new { area = "Customer", id = Model.CarId })" class="btn btn-warning w-100 mt-2">Please Login to Continue</a>
            }

            <a asp-controller="Cars" asp-action="Index" asp-route-brandId="@Model.BrandId" class="btn btn-outline-secondary w-100 mt-2">Back to @Model.Brand?.BrandName Cars</a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('click', function (e) {
            if (e.target.id === 'addToCartBtn') {
                const carId = e.target.dataset.carId;
                const startDate = document.getElementById('rentalStartDate').value;
                const endDate = document.getElementById('rentalEndDate').value;

                if (!startDate || !endDate) {
                    alert('Please select both rental start and end dates.');
                    return;
                }

                fetch('/Customer/Cars/AddToCart?carId=' + carId + '&startDate=' + startDate + '&endDate=' + endDate, {
                    method: 'POST'
                })
                .then(response => response.json())
                .then(result => {
                    if (result.success) {
                        window.location.href = '/Customer/Cart';
                    } else {
                        alert(result.message);
                    }
                });
            }
        });
    </script>
}
