@{
    ViewData["Title"] = "Home Page";
}

<div class="container">
    <div class="row gy-4 align-items-center py-5">
        <div class="col-lg-6 order-2 order-lg-1 d-flex flex-column justify-content-center text-center text-md-start">

            <h1 class="display-4 fw-bold">
                Drive Your Journey With CarRentoWeb
            </h1>

            <p class="lead mt-3">
                Find the perfect car for your journey.
                Choose from a wide range of reliable and comfortable
                vehicles and enjoy a simple car rental experience.
            </p>

            <div class="d-flex mt-4 justify-content-center justify-content-md-start gap-2">
                <a href="#" class="btn btn-primary btn-lg">
                    Browse Cars
                </a>

                <a href="#" class="btn btn-outline-primary btn-lg">
                    Learn More
                </a>
            </div>
        </div>

        <div class="col-lg-6 order-1 order-lg-2 text-center">
            <img src="https://images.unsplash.com/photo-1503376780353-7e6692767b70?auto=format&fit=crop&w=1000&q=80"
                 class="img-fluid rounded"
                 alt="Car available for rental">
        </div>
    </div>
</div>

<!-- About Section -->
<section class="py-5">
    <div class="container">
        <div class="row gy-4 align-items-center">
            <div class="col-lg-6">
                <img src="https://images.unsplash.com/photo-1549317661-bd32c8ce0db2?auto=format&fit=crop&w=1000&q=80"
                     class="img-fluid rounded"
                     alt="Car available for rental">
            </div>
            <div class="col-lg-6 ps-lg-4">
                <h2 class="fw-bold mb-3">
                    About CarRentoWeb
                </h2>

                <p class="mb-4">
                    CarRentoWeb is a simple and convenient car rental platform
                    designed to help customers find the right vehicle for their
                    journeys. Whether you are planning a weekend trip, a family
                    vacation, or need a car for everyday travel, we make the
                    rental process easy and convenient.
                </p>
                <div class="d-flex mb-4">
                    <div class="me-3">
                        <i class="bi bi-car-front fs-2 text-primary"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold">
                            Wide Range of Cars
                        </h5>
                        <p class="mb-0">
                            Choose from different types of vehicles that match
                            your travel needs and preferences.
                        </p>
                    </div>
                </div>

                <div class="d-flex mb-4">
                    <div class="me-3">
                        <i class="bi bi-calendar-check fs-2 text-primary"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold">
                            Easy Booking
                        </h5>

                        <p class="mb-0">
                            Find your preferred car and make your rental
                            booking through a simple and convenient process.
                        </p>
                    </div>
                </div>

                <div class="d-flex">
                    <div class="me-3">
                        <i class="bi bi-shield-check fs-2 text-primary"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold">
                            Reliable Service
                        </h5>
                        <p class="mb-0">
                            We aim to provide a smooth rental experience with
                            reliable vehicles and customer-focused service.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


<!-- Services Section -->
<section id="services" class="py-5">

    <div class="container text-center mb-5">
        <h2 class="fw-bold">
            Our Services
        </h2>

        <p class="text-muted">
            Everything you need for a simple, comfortable, and convenient
            car rental experience.
        </p>
    </div>

    <div class="container">
        <div class="row gy-4">
            <div class="col-lg-4 col-md-6">
                <div class="card h-100 border-0 shadow-sm">
                    <img src="https://images.unsplash.com/photo-1552519507-da3b142c6e3d?auto=format&fit=crop&w=800&q=80"
                         class="card-img-top"
                         alt="Car rental">

                    <div class="card-body text-center">
                        <div class="mb-3">
                            <i class="bi bi-car-front fs-1 text-primary"></i>
                        </div>

                        <h5 class="card-title fw-bold">
                            Car Rental
                        </h5>

                        <p class="card-text text-muted">
                            Choose from a variety of reliable and comfortable
                            cars that fit your travel requirements and budget.
                        </p>

                        <a href="#" class="btn btn-outline-primary">
                            Explore Cars
                        </a>
                    </div>
                </div>
            </div>

            <!-- Service 2 -->
            <div class="col-lg-4 col-md-6">

                <div class="card h-100 border-0 shadow-sm">

                    <img src="https://images.unsplash.com/photo-1549317661-bd32c8ce0db2?auto=format&fit=crop&w=800&q=80"
                         class="card-img-top"
                         alt="Easy car booking">

                    <div class="card-body text-center">

                        <div class="mb-3">
                            <i class="bi bi-calendar-check fs-1 text-primary"></i>
                        </div>

                        <h5 class="card-title fw-bold">
                            Easy Booking
                        </h5>

                        <p class="card-text text-muted">
                            Select your preferred vehicle, choose your rental
                            dates, and make your booking with ease.
                        </p>

                        <a href="#" class="btn btn-outline-primary">
                            Book a Car
                        </a>

                    </div>

                </div>

            </div>


            <!-- Service 3 -->
            <div class="col-lg-4 col-md-6">

                <div class="card h-100 border-0 shadow-sm">

                    <img src="https://images.unsplash.com/photo-1504215680853-026ed2a45def?auto=format&fit=crop&w=800&q=80"
                         class="card-img-top"
                         alt="Airport car rental">

                    <div class="card-body text-center">

                        <div class="mb-3">
                            <i class="bi bi-airplane fs-1 text-primary"></i>
                        </div>

                        <h5 class="card-title fw-bold">
                            Airport Pickup
                        </h5>

                        <p class="card-text text-muted">
                            Make your journey easier with convenient car rental
                            options for airport travel and transfers.
                        </p>

                        <a href="#" class="btn btn-outline-primary">
                            Learn More
                        </a>

                    </div>

                </div>

            </div>


            <!-- Service 4 -->
            <div class="col-lg-4 col-md-6">

                <div class="card h-100 border-0 shadow-sm">

                    <img src="https://images.unsplash.com/photo-1492144534655-ae79c964c9d7?auto=format&fit=crop&w=800&q=80"
                         class="card-img-top"
                         alt="Long term car rental">

                    <div class="card-body text-center">

                        <div class="mb-3">
                            <i class="bi bi-clock-history fs-1 text-primary"></i>
                        </div>

                        <h5 class="card-title fw-bold">
                            Long-Term Rental
                        </h5>

                        <p class="card-text text-muted">
                            Need a vehicle for an extended period? Our
                            long-term rental option provides flexible solutions.
                        </p>

                        <a href="#" class="btn btn-outline-primary">
                            Learn More
                        </a>

                    </div>
                </div>
            </div>

            <!-- Service 5 -->
            <div class="col-lg-4 col-md-6">

                <div class="card h-100 border-0 shadow-sm">

                    <img src="https://images.unsplash.com/photo-1503736334956-4c8f8e92946d?auto=format&fit=crop&w=800&q=80"
                         class="card-img-top"
                         alt="Business car rental">

                    <div class="card-body text-center">

                        <div class="mb-3">
                            <i class="bi bi-briefcase fs-1 text-primary"></i>
                        </div>

                        <h5 class="card-title fw-bold">
                            Corporate Rental
                        </h5>

                        <p class="card-text text-muted">
                            Flexible vehicle rental solutions for business
                            trips, meetings, and corporate transportation.
                        </p>

                        <a href="#" class="btn btn-outline-primary">
                            Learn More
                        </a>

                    </div>

                </div>

            </div>


            <!-- Service 6 -->
            <div class="col-lg-4 col-md-6">

                <div class="card h-100 border-0 shadow-sm">

                    <img src="https://images.unsplash.com/photo-1511919884226-fd3cad34687c?auto=format&fit=crop&w=800&q=80"
                         class="card-img-top"
                         alt="Premium car rental">

                    <div class="card-body text-center">

                        <div class="mb-3">
                            <i class="bi bi-star fs-1 text-primary"></i>
                        </div>

                        <h5 class="card-title fw-bold">
                            Premium Cars
                        </h5>

                        <p class="card-text text-muted">
                            Travel in style with our selection of premium
                            vehicles for special occasions and memorable trips.
                        </p>

                        <a href="#" class="btn btn-outline-primary">
                            Explore Premium Cars
                        </a>

                    </div>

                </div>

            </div>


        </div>

    </div>

</section>

<!-- Contact Section -->
<section id="contact" class="py-5">
    <div class="container text-center mb-5">
        <h2 class="fw-bold">
            Contact Us
        </h2>

        <p class="text-muted">
            Have a question about our cars or rental services?
            Get in touch with the CarRentoWeb team.
        </p>
    </div>

    <div class="container">
        <div class="mb-5">
            <div class="ratio ratio-21x9">
                <iframe
                    src="https://www.google.com/maps?q=Ernakulam,Kerala,India&output=embed"
                    style="border:0;"
                    allowfullscreen
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade">
                </iframe>

            </div>

        </div>

        <div class="row gy-4">

            <div class="col-lg-4">
                <div class="d-flex mb-4">
                    <div class="me-3">
                        <i class="bi bi-geo-alt fs-2 text-primary"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold">
                            Address
                        </h5>

                        <p class="mb-0 text-muted">
                            Ernakulam, Kerala, India
                        </p>
                    </div>
                </div>

                <div class="d-flex mb-4">

                    <div class="me-3">
                        <i class="bi bi-telephone fs-2 text-primary"></i>
                    </div>

                    <div>
                        <h5 class="fw-bold">
                            Call Us
                        </h5>

                        <p class="mb-0 text-muted">
                            +91 98765 43210
                        </p>
                    </div>
                </div>

                <div class="d-flex mb-4">

                    <div class="me-3">
                        <i class="bi bi-envelope fs-2 text-primary"></i>
                    </div>

                    <div>
                        <h5 class="fw-bold">
                            Email Us
                        </h5>

                        <p class="mb-0 text-muted">
                            info@carrentoweb.com
                        </p>
                    </div>

                </div>

                <div class="d-flex">

                    <div class="me-3">
                        <i class="bi bi-clock fs-2 text-primary"></i>
                    </div>

                    <div>
                        <h5 class="fw-bold">
                            Working Hours
                        </h5>

                        <p class="mb-0 text-muted">
                            Monday - Saturday
                        </p>

                        <p class="mb-0 text-muted">
                            9:00 AM - 6:00 PM
                        </p>
                    </div>

                </div>

            </div>

            <div class="col-lg-8">

                <div class="card border-0 shadow-sm">

                    <div class="card-body p-4">

                        <h4 class="fw-bold mb-4">
                            Send Us a Message
                        </h4>

                        <form>
                            <div class="row g-3">

                                <div class="col-md-6">

                                    <label for="name" class="form-label">
                                        Your Name
                                    </label>

                                    <input type="text"
                                           id="name"
                                           class="form-control"
                                           placeholder="Enter your name"
                                           required>

                                </div>


                                <div class="col-md-6">

                                    <label for="email" class="form-label">
                                        Your Email
                                    </label>

                                    <input type="email"
                                           id="email"
                                           class="form-control"
                                           placeholder="Enter your email"
                                           required>

                                </div>


                                <div class="col-12">

                                    <label for="subject" class="form-label">
                                        Subject
                                    </label>

                                    <input type="text"
                                           id="subject"
                                           class="form-control"
                                           placeholder="Enter subject"
                                           required>

                                </div>


                                <div class="col-12">

                                    <label for="message" class="form-label">
                                        Message
                                    </label>

                                    <textarea id="message"
                                              class="form-control"
                                              rows="6"
                                              placeholder="Write your message here..."
                                              required></textarea>

                                </div>


                                <div class="col-12">

                                    <button type="submit"
                                            class="btn btn-primary px-4">
                                        <i class="bi bi-send me-2"></i>
                                        Send Message
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
