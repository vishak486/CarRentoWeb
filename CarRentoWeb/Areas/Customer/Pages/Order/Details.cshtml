@page "{id:int}"
@model CarRentoWeb.Areas.Customer.Pages.Order.Details
@{
    ViewData["Title"] = "Order Details";
}

<div class="card shadow border-0 mt-4 w-100">
    <div class="card-header bg-primary mt-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white fw-bold">Order #@Model.Order!.OrderId</h2>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        <div class="row pb-3">
            <div class="col-md-6">
                <p class="mb-1"><strong>Placed on:</strong> @Model.Order.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</p>
                <p class="mb-1">
                    <strong>Order status:</strong>
                    <span class="badge @(Model.Order.Status == CarRentoWeb.Models.OrderStatus.Completed ? "bg-success" : Model.Order.Status == CarRentoWeb.Models.OrderStatus.Failed ? "bg-danger" : "bg-warning text-dark")">
                        @Model.Order.Status
                    </span>
                </p>
                @if (Model.Order.Payment != null)
                {
                    <p class="mb-1"><strong>Payment status:</strong> @Model.Order.Payment.Status</p>
                    @if (!string.IsNullOrEmpty(Model.Order.Payment.ProviderPaymentId))
                    {
                        <p class="mb-1"><strong>Payment ID:</strong> @Model.Order.Payment.ProviderPaymentId</p>
                    }
                }
            </div>
            <div class="col-md-6 text-md-end">
                <a asp-area="Customer" asp-controller="Order" asp-action="Index" class="btn btn-outline-primary">Back to Orders</a>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>Car</th>
                        <th>Dates</th>
                        <th>Days</th>
                        <th>Price/Day</th>
                        <th>Line Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Order.OrderItems!)
                    {
                        <tr>
                            <td>@item.Car?.CarName</td>
                            <td>@item.RentalStartDate.ToString("dd MMM yyyy") - @item.RentalEndDate.ToString("dd MMM yyyy")</td>
                            <td>@item.Days</td>
                            <td>₹@item.PricePerDay.ToString("N2")</td>
                            <td>₹@item.LineTotal.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="text-end">
            <p class="mb-1">Subtotal: ₹@Model.Order.SubTotal.ToString("N2")</p>
            <p class="mb-1">Tax: ₹@Model.Order.Tax.ToString("N2")</p>
            <h4 class="fw-bold">Total: ₹@Model.Order.Total.ToString("N2")</h4>
        </div>
    </div>
</div>