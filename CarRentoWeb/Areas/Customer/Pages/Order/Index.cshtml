@page
@model CarRentoWeb.Areas.Customer.Pages.Order.IndexModel
@{
    ViewData["Title"] = "My Orders";
}

<div class="card shadow border-0 mt-4 w-100">
    <div class="card-header bg-primary mt-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white fw-bold">My Orders</h2>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        @if (!Model.Orders.Any())
        {
            <p class="text-muted">You have no orders yet.</p>
            <a asp-area="Customer" asp-controller="Brands" asp-action="Index" class="btn btn-primary">Browse Cars</a>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped align-middle">
                    <thead>
                        <tr>
                            <th>Order #</th>
                            <th>Placed On</th>
                            <th>Cars</th>
                            <th>Total</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.Orders)
                        {
                            <tr>
                                <td>@order.OrderId</td>
                                <td>@order.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                                <td>@string.Join(", ", order.OrderItems!.Select(oi => oi.Car?.CarName))</td>
                                <td>₹@order.Total.ToString("N2")</td>
                                <td><span class="badge bg-success">@order.Status</span></td>
                                <td>
                                    <a asp-area="Customer" asp-page="/Order/Details" asp-route-id="@order.OrderId" class="btn btn-sm btn-primary">View</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>