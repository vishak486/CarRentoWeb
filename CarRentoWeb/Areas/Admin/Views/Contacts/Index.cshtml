@{
	ViewData["Title"] = "Manage Contacts";
}

@Html.AntiForgeryToken()


<div class="card shadow border-0 mt-4">
	<div class="card-header bg-primary mt-0 py-3">
		<div class="row">
			<div class="col-12 text-center">
				<h2 class="text-white fw-bolder">Manage Contacts</h2>
			</div>
		</div>
	</div>
	<div class="card-body p-4">
		<div class="row pt-4 pb-3">
			<div class="col-6">
			</div>
			<div class="col-6 text-end">
			</div>
		</div>
		<div class="table-responsive">
			<table id="contactsTable" class="table table-striped table-hover">
				<thead class="table-light">
					<tr>
						<th width="15%">Name</th>
						<th width="20%">Email</th>
						<th width="25%">Subject</th>
						<th width="25%">Message</th>
						<th width="20%">Date</th>
						<th width="20%">Actions</th>
					</tr>
				</thead>
				<tbody></tbody>
			</table>
		</div>
	</div>
</div>

@section Scripts {
	<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
	<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
	<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

	<script>
		$(document).ready(function () {
			loadDataTable();
		});

		function loadDataTable() {
			$('#contactsTable').DataTable({
				"ajax": { url: '/Admin/Contacts/GetAll', type: 'POST' },
				"columns": [
					{ data: "name", width: "15%" },
					{ data: "email", width: "20%" },
					{ data: "subject", width: "25%" },
					{ data: "message", width: "25%" },
					{
						data: "createdAt", width: "20%",
						render: function (data) {
							return new Date(data).toLocaleDateString('en-US', {
								year: 'numeric',
								month: 'short',
								day: '2-digit',
								hour: '2-digit',
								minute: '2-digit'
							});
						}
					},
					{
						data: "id", width: "20%",
						render: function (data) {
							return `<button class="btn btn-sm btn-danger" onclick="deleteContact(${data})">
										<i class="bi bi-trash"></i> Delete
									</button>
									`;
						}
					}
				],
				"processing": true,
				"serverSide": false,
				"bDestroy": true,
				"responsive": true,
				"pagingType": "full_numbers",
				"pageLength": 10
			});
		}

		function deleteContact(id) {
			const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
			if (confirm('Are you sure you want to delete this contact?')) {
				fetch(`/Admin/Contacts/Delete/${id}`, {
					method: 'POST',
					headers: {
						'Content-Type': 'application/json',
						'RequestVerificationToken': token
					}
				})
				.then(response => response.json())
				.then(data => {
					if (data.success) {
						//alert('Contact deleted successfully!');
						$('#contactsTable').DataTable().ajax.reload();
					} else {
						alert('Error: ' + data.message);
					}
				})
				.catch(error => {
					alert('Failed to delete contact: ' + error);
				});
			}
		}

	</script>
}
