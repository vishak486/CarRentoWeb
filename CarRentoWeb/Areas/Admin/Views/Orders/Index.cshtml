@{
    ViewData["Title"] = "Manage Orders";
}

<div class="card shadow border-0 mt-4" style="min-width: 0;">
    <div class="card-header bg-primary mt-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white fw-5">Rental Orders</h2>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        <div class="table-responsive">
            <table id="orderTable" class="table table-striped" style="width:100%">
                <thead>
                    <tr>
                        <th>Order #</th>
                        <th>Customer</th>
                        <th>Cars</th>
                        <th>Placed On</th>
                        <th>Total</th>
                        <th>Status</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var table = new DataTable('#orderTable', {
            ajax: { url: '/Admin/Orders/GetAll' },
            order: [[0, 'desc']],
            columns: [
                { data: 'orderId' },
                { data: 'customer' },
                { data: 'cars' },
                { data: 'createdAt' },
                {
                    data: 'total',
                    render: function(data) { return '₹' + Number(data).toLocaleString('en-IN', { minimumFractionDigits: 2 }); }
                },
                {
                    data: 'status',
                    render: function(data) { return '<span class="badge bg-success">' + data + '</span>'; }
                }
            ]
        });
    </script>
}