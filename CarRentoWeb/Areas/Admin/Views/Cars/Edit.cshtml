@model Car
@{
	var brandList = ViewBag.BrandList as List<Brand>;
}

<div class="card shadow border-0 mt-4">
    <div class="card-header bg-primary mt-0 py-3">
        <div class="row">
            <div class="col-12 text-center">
                <h2 class="text-white fw-5">Edit Car</h2>
            </div>
        </div>
    </div>
    <div class="card-body p-4">
        <div class="row pt-4 pb-3">
            <div class="col-6">
            </div>
            <div class="col-6 text-end">
                <a asp-controller="Cars" asp-action="Index" class="btn btn-outline-primary"><i class="bi bi-plus-circle"></i> Back to Cars</a>
            </div>
        </div>

        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="CarId" />

            <div class="mb-3">
                <label class="form-label">Brand</label>
                <select asp-for="BrandId" class="form-select" asp-items="@(new SelectList(brandList, "BrandId", "BrandName"))">
                </select>
                <span asp-validation-for="BrandId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CarName" class="form-label"></label>
                <input asp-for="CarName" class="form-control" />
                <span asp-validation-for="CarName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Model" class="form-label"></label>
                <input asp-for="Model" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Year" class="form-label"></label>
                <input asp-for="Year" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Transmission" class="form-label"></label>
                <input asp-for="Transmission" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="FuelType" class="form-label"></label>
                <input asp-for="FuelType" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="SeatingCapacity" class="form-label"></label>
                <input asp-for="SeatingCapacity" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="PricePerDay" class="form-label"></label>
                <input asp-for="PricePerDay" class="form-control" />
            </div>

            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" class="btn btn-secondary">Back</a>
        </form>
       
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
